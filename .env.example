# SQLite database file. The container mounts this on a volume.
DATABASE_URL=local.db

# --- Cloudflare Access -------------------------------------------------------
# Your team domain: "myteam", or the full "myteam.cloudflareaccess.com".
CF_ACCESS_TEAM_DOMAIN=myteam
# The Application Audience (AUD) tag from the Access application's settings.
# Required: without it, a token minted for any other application in the same
# team would verify successfully here.
CF_ACCESS_AUD=

# --- Local development -------------------------------------------------------
# Skips Access verification and treats every request as this account. Only read
# when `dev` is true, so it has no effect on a production build.
AUTH_DEV_EMAIL=you@example.com

# --- Seeding (pnpm db:seed) --------------------------------------------------
SEED_EMAIL=you@example.com
SEED_FRIEND_EMAIL=friend@example.com
