# Copy to /etc/workout-backup.env on the Pi, fill in, then hand it to the user
# the backup runs as — root ownership breaks both the manual run and restic's
# read of the password file under systemd:
#   sudo chown greggon:greggon /etc/workout-backup.env
#   sudo chmod 600 /etc/workout-backup.env

# Where the live data lives — the host side of the ./data:/data compose volume.
DATA_DIR=/home/greggon/apps/workout/data

# Cloudflare R2. Bucket must already exist; restic will init the repo itself.
# A path suffix keeps this separate from the hsa repository, which has its own
# password and must stay independently restorable.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/workout
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 ignores the region but the S3 client insists on one.
AWS_DEFAULT_REGION=auto

# The key to your data. Generate once, and STORE IT SOMEWHERE ELSE TOO —
# without it the backups are unreadable ciphertext:
#   openssl rand -base64 32 | sudo tee /etc/workout-backup.key
#   sudo chown greggon:greggon /etc/workout-backup.key && sudo chmod 600 /etc/workout-backup.key
RESTIC_PASSWORD_FILE=/etc/workout-backup.key

# Optional: https://healthchecks.io ping URLs. Free, and the only thing that
# tells you the backup stopped running.
#HEALTHCHECK_URL=https://hc-ping.com/<uuid>
#RESTORE_CHECK_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# Refuse to back up a database that has suddenly emptied.
#
# Starts at 0 because a fresh install has no logged sets, and a non-zero guard
# would block the very first backup — and therefore every deploy. RAISE THIS
# once you have real history; the nightly log nags until you do. Somewhere
# below your current set count is right: it only has to catch a wipe.
MIN_EXPECTED_ROWS=0
